# DeepSeek Claude Code Launcher
# Copy this file to .env (git-ignored) and fill in your values.
# Only these three are required — everything else has sensible defaults.
#
# Usage:
#   node DPT_FRAMEWORK/host_tools/claude-deepseek.mjs --check    # verify setup
#   node DPT_FRAMEWORK/host_tools/claude-deepseek.mjs -p "hello" # launch Claude Code
#
# See DPT_FRAMEWORK/host_tools/README.md for full documentation.

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
