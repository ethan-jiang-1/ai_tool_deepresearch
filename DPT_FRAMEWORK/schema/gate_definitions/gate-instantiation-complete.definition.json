{
  "gate": "instantiation-complete",
  "description": "Verify a valid dpt_rb_* or dpt_disp_* run bundle has been instantiated with all canonical control files, scaffold directories, and correct status values.",
  "rules": [
    {
      "id": "bundle_dir_exists",
      "check": "dir_exists",
      "target": ".",
      "failure_message": "Bundle directory does not exist. Run instantiate-run-bundle.mjs to create it.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "bundle_map_exists",
      "check": "file_exists",
      "target": "BUNDLE_MAP.md",
      "failure_message": "Missing BUNDLE_MAP.md. Create it from the template.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_plan_exists",
      "check": "file_exists",
      "target": "rb_plan.md",
      "failure_message": "Missing control file: rb_plan.md. Create it from the template.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_profile_exists",
      "check": "file_exists",
      "target": "rb_profile.yaml",
      "failure_message": "Missing control file: rb_profile.yaml. Create it from the template.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_status_exists",
      "check": "file_exists",
      "target": "rb_status.json",
      "failure_message": "Missing control file: rb_status.json. Create it from the template.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_queue_exists",
      "check": "file_exists",
      "target": "rb_queue.json",
      "failure_message": "Missing control file: rb_queue.json. Create it from the template.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_trace_exists",
      "check": "file_exists",
      "target": "rb_trace.jsonl",
      "failure_message": "Missing control file: rb_trace.jsonl. Create an empty file.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "seed_topics_exists",
      "check": "dir_exists",
      "target": "seed_topics",
      "failure_message": "Missing scaffold directory: seed_topics/. Create it.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "reference_exists",
      "check": "dir_exists",
      "target": "reference",
      "failure_message": "Missing scaffold directory: reference/. Create it.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "artifacts_exists",
      "check": "dir_exists",
      "target": "artifacts",
      "failure_message": "Missing scaffold directory: artifacts/. Create it.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "cache_exists",
      "check": "dir_exists",
      "target": "_cache",
      "failure_message": "Missing scaffold directory: _cache/. Create it.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "final_exists",
      "check": "dir_exists",
      "target": "final",
      "failure_message": "Missing scaffold directory: final/. Create it.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "work_units_exists",
      "check": "dir_exists",
      "target": "_work_units",
      "failure_message": "Missing runtime directory: _work_units/. Re-instantiate or restore the active bundle root structure.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "bundle_name_valid",
      "check": "pattern_match",
      "target": ".",
      "pattern": "^(dpt_rb_[a-z0-9][a-z0-9-]*|dpt_disp_[a-z0-9][a-z0-9_-]*_[0-9a-f]+)$",
      "failure_message": "Bundle directory name does not match accepted naming pattern. Production: dpt_rb_<kebab-name>. Disposable: dpt_disp_<name>_<hex>. Re-instantiate with a legal name.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "status_current_mode",
      "check": "status_value",
      "target": "rb_status.json#/current_mode",
      "expected": "execution",
      "failure_message": "rb_status.json current_mode must be 'execution'.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "status_current_gate",
      "check": "status_value",
      "target": "rb_status.json#/current_gate",
      "expected": "setup_ready",
      "failure_message": "rb_status.json current_gate must be 'setup_ready' after instantiation.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "status_next_gate",
      "check": "status_value",
      "target": "rb_status.json#/next_gate",
      "expected": "seed_topics_ready",
      "failure_message": "rb_status.json next_gate must be 'seed_topics_ready' after instantiation.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DPT_FRAMEWORK/cli/instantiate-run-bundle.mjs" }
    }
  ]
}
