{
  "gate": "wave2-complete",
  "description": "Inactive test-only Wave2 degradation eligibility fixture.",
  "rules": [
    {
      "id": "fixture_wave2_quality_floor",
      "check": "count_floor",
      "target": "reference/00-cross-*.md",
