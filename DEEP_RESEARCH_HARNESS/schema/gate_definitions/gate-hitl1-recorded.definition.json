{
  "gate": "hitl1-recorded",
  "description": "Verify HITL1 user input has been recorded to rb_profile.yaml: research_profile selected, root_must_answer_set non-empty, hitl1 status marker written.",
  "rules": [
    {
      "id": "profile_exists",
      "check": "file_exists",
      "target": "rb_profile.yaml",
      "failure_message": "rb_profile.yaml does not exist. The bundle may not have been instantiated.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "profile_schema_valid",
      "check": "schema_valid",
      "target": "rb_profile.yaml",
      "schema": "ProfileSchema",
      "failure_message": "rb_profile.yaml exists but fails ProfileSchema validation. Check inspect output for specific field errors.",
      "finding": { "source": "checker" }
    },
    {
      "id": "research_access_available",
      "check": "field_value",
      "target": "rb_profile.yaml#/research_access/status",
      "operator": "equal",
      "value": "available",
      "failure_message": "research_access.status is not 'available'. If research_access.reason exists, read it; repair or switch the environment, then rerun the same real HITL1 search/fetch probe and this gate. Do not enter Setup.",
      "finding": { "source": "checker" }
    },
    {
      "id": "research_profile_not_default",
      "check": "field_value",
      "target": "rb_profile.yaml#/research_profile",
      "operator": "not_equal",
      "value": "not_selected",
      "failure_message": "research_profile is still 'not_selected'. The user must choose a research profile (quick_factual, exploratory_map, or claim_verification) during HITL1.",
      "finding": { "source": "definition", "blocking_basis": "recorded_human_decision" },
      "repair": { "kind": "user_decision", "write_to": "phases/phase-hitl1.md" }
    },
    {
      "id": "must_answer_non_empty",
      "check": "field_non_empty",
      "target": "rb_profile.yaml#/root_must_answer_set",
      "failure_message": "root_must_answer_set is empty. The user must specify at least one must-answer question during HITL1.",
      "finding": { "source": "definition", "blocking_basis": "recorded_human_decision" },
      "repair": { "kind": "user_decision", "write_to": "phases/phase-hitl1.md" }
    },
    {
      "id": "hitl1_status_recorded",
      "check": "field_value",
      "target": "rb_profile.yaml#/human_decision_checkpoints/hitl1/status",
      "operator": "equal",
      "value": "recorded",
      "failure_message": "hitl1.status is not 'recorded'. After collecting user answers, set status to 'recorded'.",
      "finding": { "source": "definition", "blocking_basis": "recorded_human_decision" },
      "repair": { "kind": "user_decision", "write_to": "phases/phase-hitl1.md" }
    },
    {
      "id": "hitl1_recorded_at_non_empty",
      "check": "field_non_empty",
      "target": "rb_profile.yaml#/human_decision_checkpoints/hitl1/recorded_at",
      "failure_message": "hitl1.recorded_at is missing or empty. Write the ISO 8601 timestamp when HITL1 was recorded.",
      "finding": { "source": "checker" }
    },
    {
      "id": "status_current_gate",
      "check": "status_value",
      "target": "rb_status.json#/current_gate",
      "expected": "hitl1_recorded",
      "failure_message": "rb_status.json current_gate must be 'hitl1_recorded'. Use advance-status --to hitl1_recorded to advance.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/advance-status.mjs --bundle {bundle} --to hitl1_recorded" }
    },
    {
      "id": "status_next_gate",
      "check": "status_value",
      "target": "rb_status.json#/next_gate",
      "expected": "setup_ready",
      "failure_message": "rb_status.json next_gate must be 'setup_ready'. Use advance-status --to hitl1_recorded to set the correct next_gate.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/advance-status.mjs --bundle {bundle} --to hitl1_recorded" }
    }
  ]
}
