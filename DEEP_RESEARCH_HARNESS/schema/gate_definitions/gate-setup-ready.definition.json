{
  "gate": "setup-ready",
  "description": "Verify the instantiated bundle has structural consistency: canonical control files exist and parse, scaffold directories exist, HITL1 is recorded, bootstrap-compatible setup status is present, and bundle basename agrees with plan/profile basename. setup-ready is NOT readiness-passed — it only checks structure, not research quality.",
  "rules": [
    {
      "id": "rb_plan_exists",
      "check": "file_exists",
      "target": "rb_plan.md",
      "failure_message": "Missing control file: rb_plan.md.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_profile_exists",
      "check": "file_exists",
      "target": "rb_profile.yaml",
      "failure_message": "Missing control file: rb_profile.yaml.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_status_exists",
      "check": "file_exists",
      "target": "rb_status.json",
      "failure_message": "Missing control file: rb_status.json.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_queue_exists",
      "check": "file_exists",
      "target": "rb_queue.json",
      "failure_message": "Missing control file: rb_queue.json.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "rb_trace_exists",
      "check": "file_exists",
      "target": "rb_trace.jsonl",
      "failure_message": "Missing control file: rb_trace.jsonl.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "seed_topics_exists",
      "check": "dir_exists",
      "target": "seed_topics",
      "failure_message": "Missing scaffold directory: seed_topics/.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "reference_exists",
      "check": "dir_exists",
      "target": "reference",
      "failure_message": "Missing scaffold directory: reference/.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "artifacts_exists",
      "check": "dir_exists",
      "target": "artifacts",
      "failure_message": "Missing scaffold directory: artifacts/.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "cache_exists",
      "check": "dir_exists",
      "target": "_cache",
      "failure_message": "Missing scaffold directory: _cache/.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "final_exists",
      "check": "dir_exists",
      "target": "final",
      "failure_message": "Missing scaffold directory: final/.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "work_units_exists",
      "check": "dir_exists",
      "target": "_work_units",
      "failure_message": "Missing runtime directory: _work_units/.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/instantiate-run-bundle.mjs" }
    },
    {
      "id": "plan_schema_valid",
      "check": "schema_valid",
      "target": "rb_plan.md",
      "schema": "PlanSchema",
      "failure_message": "rb_plan.md fails PlanSchema validation.",
      "finding": { "source": "checker" }
    },
    {
      "id": "profile_schema_valid",
      "check": "schema_valid",
      "target": "rb_profile.yaml",
      "schema": "ProfileSchema",
      "failure_message": "rb_profile.yaml fails ProfileSchema validation.",
      "finding": { "source": "checker" }
    },
    {
      "id": "status_schema_valid",
      "check": "schema_valid",
      "target": "rb_status.json",
      "schema": "StatusSchema",
      "failure_message": "rb_status.json fails StatusSchema validation.",
      "finding": { "source": "checker" }
    },
    {
      "id": "queue_schema_valid",
      "check": "schema_valid",
      "target": "rb_queue.json",
      "schema": "QueueSchema",
      "failure_message": "rb_queue.json fails QueueSchema validation.",
      "finding": { "source": "checker" }
    },
    {
      "id": "hitl1_marker_recorded",
      "check": "field_value",
      "target": "rb_profile.yaml#/human_decision_checkpoints/hitl1/status",
      "operator": "equal",
      "value": "recorded",
      "failure_message": "HITL1 has not been recorded. Complete the HITL1 phase before proceeding to wave0.",
      "finding": { "source": "definition", "blocking_basis": "recorded_human_decision" },
      "repair": { "kind": "user_decision", "write_to": "phases/phase-hitl1.md" }
    },
    {
      "id": "status_current_gate",
      "check": "status_value",
      "target": "rb_status.json#/current_gate",
      "expected": "setup_ready",
      "failure_message": "rb_status.json current_gate must be 'setup_ready'. Status may have drifted — restore the correct gate value.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/advance-status.mjs --bundle {bundle} --to setup_ready" }
    },
    {
      "id": "status_next_gate",
      "check": "status_value",
      "target": "rb_status.json#/next_gate",
      "expected": "seed_topics_ready",
      "failure_message": "rb_status.json next_gate must be 'seed_topics_ready'. Status may have drifted — restore the correct value.",
      "finding": { "source": "definition", "blocking_basis": "binding_integrity" },
      "repair": { "kind": "engine_operation", "write_to": "node DEEP_RESEARCH_HARNESS/cli/advance-status.mjs --bundle {bundle} --to setup_ready" }
    },
    {
      "id": "basename_consistency",
      "check": "cross_field",
      "fields": [
        { "source": "bundle_dir_basename", "transform": "normalize_bundle_basename" },
        { "source": "rb_plan.md#/plan_basename" },
        { "source": "rb_profile.yaml#/plan_basename" }
      ],
      "normalization": {
        "dpt_rb_<name>": "<name>",
        "dpt_disp_<name>_<hex>": "<name> (hex = one or more [0-9a-f])"
      },
      "comparison": "byte-for-byte",
      "failure_message": "Basename mismatch: bundle directory basename (normalized), rb_plan.md plan_basename, and rb_profile.yaml plan_basename must be byte-for-byte equal. No case folding, slug rewriting, or whitespace trimming allowed. If bundle dir has an illegal name (fails normalization), re-instantiate with a legal name — do not rename or patch files.",
      "finding": { "source": "checker" }
    },
    {
      "id": "plan_body_non_empty",
      "check": "field_non_empty",
      "target": "rb_plan.md",
      "failure_message": "rb_plan.md body is empty. The plan body must contain at least the filled template sections — Goal Purpose, Research Questions, and Scope must be written before setup-ready gate.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "agent_action", "write_to": "$checked_target" }
    },
    {
      "id": "plan_body_no_unfilled_marker",
      "check": "pattern_match",
      "target": "rb_plan.md",
      "pattern": "\\((?:待填充|尚无话题)",
      "negate": true,
      "failure_message": "rb_plan.md body contains unfilled required-fill markers (待填充… or 尚无话题…). Replace all required-fill markers in ## Goal subsections with real content before proceeding.",
      "finding": { "source": "definition", "blocking_basis": "required_structure" },
      "repair": { "kind": "agent_action", "write_to": "$checked_target" }
    }
  ]
}
